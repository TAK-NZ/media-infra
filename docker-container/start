#!/bin/sh
#
# MediaMTX container entrypoint.
#
# Prepares TLS material and runtime config, starts the Node API server, then
# hands PID 1 to MediaMTX.
#

set -eu

cd /

LOGLEVEL=${LOG_LEVEL:-info}
AUTH_ADDRESS="http://127.0.0.1:9995/auth"

if [ "${CLOUDTAK_Mode:-}" = "docker-compose" ] && printf '%s' "$API_URL" | grep -q 'localhost'; then
  API_URL=$(printf '%s' "$API_URL" | sed 's/localhost/api/')
  export API_URL
fi

#
# Advertise the public hostname to WebRTC clients.
#
# webrtcIPsFromInterfaces is disabled because the instance's interfaces only
# carry private addresses. The public FQDN resolves to the Elastic IP, so that
# is what ICE candidates must reference.
#
if [ -n "${CLOUDTAK_Config_media_url:-}" ]; then
  WEBRTC_HOST=$(node -e "console.log(new URL(process.env.CLOUDTAK_Config_media_url).hostname)" 2>/dev/null || true)

  if [ -n "$WEBRTC_HOST" ]; then
    if [ -n "${MTX_WEBRTCADDITIONALHOSTS:-}" ]; then
      case ",${MTX_WEBRTCADDITIONALHOSTS}," in
        *",${WEBRTC_HOST},"*) ;;
        *) export MTX_WEBRTCADDITIONALHOSTS="${MTX_WEBRTCADDITIONALHOSTS},${WEBRTC_HOST}" ;;
      esac
    else
      export MTX_WEBRTCADDITIONALHOSTS="$WEBRTC_HOST"
    fi
    echo "ok - advertising WebRTC host ${MTX_WEBRTCADDITIONALHOSTS}"
  fi
fi

sed -i "s|^authHTTPAddress: .*|authHTTPAddress: ${AUTH_ADDRESS}|" /mediamtx.yml
sed -i "s|^logLevel: .*|logLevel: ${LOGLEVEL}|" /mediamtx.yml

#
# Export the TLS certificate from ACM.
#
# There is no load balancer terminating TLS, so MediaMTX and the Node API server
# serve it directly. Every public listener (HLS, playback, WebRTC, RTMPS, RTSPS,
# API) is configured for TLS and will not start without these files, so a failure
# here is fatal by design — degrading to plaintext on public ports would be worse
# than not starting.
#
if [ -z "${ACM_CERTIFICATE_ARN:-}" ]; then
  echo "FATAL: ACM_CERTIFICATE_ARN is not set; cannot obtain TLS material" >&2
  exit 1
fi

passphrase_file=/tmp/acm-passphrase
export_file=/tmp/acm-certificate.json
encrypted_key_file=/tmp/server.encrypted.key

cleanup_tls_temp() {
  rm -f "$passphrase_file" "$export_file" "$encrypted_key_file"
}
trap cleanup_tls_temp EXIT

openssl rand -base64 48 | tr -d '\n' > "$passphrase_file"

if ! aws acm export-certificate \
      --certificate-arn "$ACM_CERTIFICATE_ARN" \
      --passphrase "fileb://${passphrase_file}" \
      --output json > "$export_file"; then
  echo "FATAL: acm export-certificate failed for $ACM_CERTIFICATE_ARN" >&2
  echo "The certificate must have been issued with export enabled." >&2
  exit 1
fi

jq -r '(.Certificate // "") + "\n" + (.CertificateChain // "")' "$export_file" > /server.crt
jq -r '.PrivateKey' "$export_file" > "$encrypted_key_file"
openssl pkcs8 -in "$encrypted_key_file" -out /server.key -passin "file:${passphrase_file}"

chmod 600 /server.key
chmod 644 /server.crt

cleanup_tls_temp
trap - EXIT

echo "ok - TLS certificate loaded from ACM"

node /dist/index.js &

exec /mediamtx /mediamtx.yml
