#!/bin/sh
#
# MediaMTX container entrypoint.
#
# Prepares TLS material and runtime config, starts the Node API server, then
# hands PID 1 to MediaMTX.
#

set -eu

cd /

LOGLEVEL=${LOG_LEVEL:-info}
AUTH_ADDRESS="http://127.0.0.1:9995/auth"

if [ "${CLOUDTAK_Mode:-}" = "docker-compose" ] && printf '%s' "$API_URL" | grep -q 'localhost'; then
  API_URL=$(printf '%s' "$API_URL" | sed 's/localhost/api/')
  export API_URL
fi

#
# Advertise the public hostname to WebRTC clients.
#
# webrtcIPsFromInterfaces is disabled because the instance's interfaces only
# carry private addresses. The public FQDN resolves to the Elastic IP, so that
# is what ICE candidates must reference.
#
if [ -n "${CLOUDTAK_Config_media_url:-}" ]; then
  WEBRTC_HOST=$(node -e "console.log(new URL(process.env.CLOUDTAK_Config_media_url).hostname)" 2>/dev/null || true)

  if [ -n "$WEBRTC_HOST" ]; then
    if [ -n "${MTX_WEBRTCADDITIONALHOSTS:-}" ]; then
      case ",${MTX_WEBRTCADDITIONALHOSTS}," in
        *",${WEBRTC_HOST},"*) ;;
        *) export MTX_WEBRTCADDITIONALHOSTS="${MTX_WEBRTCADDITIONALHOSTS},${WEBRTC_HOST}" ;;
      esac
    else
      export MTX_WEBRTCADDITIONALHOSTS="$WEBRTC_HOST"
    fi
    echo "ok - advertising WebRTC host ${MTX_WEBRTCADDITIONALHOSTS}"
  fi
fi

sed -i "s|^authHTTPAddress: .*|authHTTPAddress: ${AUTH_ADDRESS}|" /mediamtx.yml
sed -i "s|^logLevel: .*|logLevel: ${LOGLEVEL}|" /mediamtx.yml

#
# Write TLS material to disk before anything that serves it starts.
#
# There is no load balancer terminating TLS, so MediaMTX and the Node API server
# serve it directly. Every internet-facing listener is configured for TLS and
# will not bind without these files, so this step is fatal on failure — it runs
# synchronously ahead of both servers rather than racing them.
#
node /dist/export-certificate.js

node /dist/index.js &

exec /mediamtx /mediamtx.yml
